# ── Server ────────────────────────────────────────────────────────────────
PORT=3000
HOST=0.0.0.0

# Identitas tool yang dikirim sebagai User-Agent ke API pihak ketiga.
# WAJIB diisi nama + kontak agar tidak diblokir (Nominatim / ip-api.com).
CONTACT_NAME=Chameleon Console
CONTACT_EMAIL=you@example.com

# Batas request paralel & timeout per request
CONCURRENCY=12
TIMEOUT_MS=12000

# ── Jaringan ─────────────────────────────────────────────────────────────
# Default: IPv4 lebih dulu. Node 20+ ("Happy Eyeballs") mencoba IPv6 dulu,
# dan di jaringan tanpa jalur IPv6 (container, sebagian VPN) Node gagal total
# meski IPv4 sehat. Set 1 untuk memakai perilaku bawaan Node.
# OS_FAVOR_IPV6=1

# ── Have I Been Pwned ─────────────────────────────────────────────────────
# Tanpa key, modul kebocoran mengembalikan status "unconfigured" dan
# mengarahkan ke Firefox Monitor. TIDAK PERNAH mengarang hasil.
# Key gratis: https://haveibeenpwned.com/API/Key
# HIBP_API_KEY=

# ── Numverify (opsional) ─────────────────────────────────────────────────
# Validasi nomor terhadap database operator: nama operator, tipe baris,
# negara, dan apakah nomor sudah di-porting. Tanpa key, modul info-nomor
# tetap jalan penuh dari metadata E.164 offline — key hanya menambah
# konfirmasi dari sisi operator.
# Key: https://numverify.com/product (free tier 1000/hari)
# NUMVERIFY_API_KEY=

# ── Meta WhatsApp Cloud API (opsional) ───────────────────────────────────
#
# CATATAN: Cloud API TIDAK bisa mengecek apakah nomor ACAK terdaftar di
# WhatsApp — endpoint yang tersedia hanya mengembalikan nomor bisnis Anda
# sendiri. Jadi token ini HANYA dipakai untuk memvalidasi kredensial, bukan
# untuk menyatakan nomor target "terdaftar".
#
# Kalau Anda pemilik bisnis dan ingin jawaban definitif untuk nomor yang ada
# di daftar kontak Anda sendiri, lakukan manual lewat tautan wa.me.
# META_WA_TOKEN=
# META_PHONE_NUMBER_ID=
# META_GRAPH_VERSION=v19.0

# ── Telegram Bot (opsional) ──────────────────────────────────────────────
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# ── Maltego ───────────────────────────────────────────────────────────────
# URL Transform Provider yang Anda daftarkan di Maltego
# (Tools > Import > Maltego Transform Provider).
#
# TIDAK ADA variabel push. Maltego tidak mengekspos API publik untuk menulis
# entity ke graph yang sedang berjalan — port 61184 yang dulu disebut tidak
# ada di Maltego CE. Satu-satunya jalur resmi adalah Transform Provider ini.
# MALTEGO_PROVIDER_URL=http://localhost:3000/api/maltego/transform