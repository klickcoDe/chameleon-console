[Unit]
Description=Chameleon Console — konsol investigasi OSINT lokal
Documentation=https://github.com/klickcoDe/chameleon-console
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=chameleon
Group=chameleon
WorkingDirectory=/opt/chameleon-console
Environment=NODE_ENV=production
# Tanda "-" = berkas boleh tidak ada (aplikasi memakai nilai bawaan).
EnvironmentFile=-/opt/chameleon-console/.env
ExecStart=/usr/bin/node server.js
Restart=on-failure
RestartSec=3
TimeoutStopSec=20
KillSignal=SIGTERM
SyslogIdentifier=chameleon-console

# Riwayat investigasi berisi data pribadi: hanya pemilik yang boleh membaca.
UMask=0077

# Pengerasan. Node butuh JIT, jadi MemoryDenyWriteExecute sengaja TIDAK dipakai.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectClock=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=true
LockPersonality=true
# Satu-satunya direktori yang boleh ditulis: riwayat + cache OFAC.
ReadWritePaths=/opt/chameleon-console/data

[Install]
WantedBy=multi-user.target
